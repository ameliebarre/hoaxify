# Postgres (consumed by docker-compose.yml)
POSTGRES_USER=hoaxify
POSTGRES_PASSWORD=hoaxify
POSTGRES_DB=hoaxify

# App
DATABASE_URL=postgresql://hoaxify:hoaxify@localhost:5432/hoaxify
ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
REFRESH_SECRET=replace-with-a-different-random-string-of-at-least-32-characters
ENV=development
PORT=8000